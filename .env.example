# YouTube Shorts Automation - Vercel Environment Variables
# Import this repo to Vercel, then add these variables in
# Project Settings > Environment Variables.

# Single-owner access key (pre-configured as required: Subhan 734)
OWNER_ACCESS_KEY=Subhan 734

# Supabase (obtain from Supabase project Settings > API)
SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_ANON_KEY=<your-anon-publishable-key>
SUPABASE_SERVICE_ROLE_KEY=<your-service-role-key>  # server-side only

# Encryption key for at-rest credentials (generate a random string)
ENCRYPTION_KEY=<random-string>

# Cron secret (protects /api/cron-publish from direct HTTP triggers)
CRON_SECRET=<random-string>

# Telegram (optional here; can also be set via website API Settings)
TELEGRAM_BOT_TOKEN=<your-bot-token>
TELEGRAM_CHAT_ID=<owner-chat-id>
TELEGRAM_WEBHOOK_SECRET=<webhook-secret>

# Groq (optional here; can also be set via website API Settings)
GROQ_API_KEY=<your-groq-api-key>
GROQ_MODEL=llama-3.1-8b-instant

# Google / YouTube OAuth (optional here; can also be set via website API Settings)
GOOGLE_CLIENT_ID=<your-google-client-id>
GOOGLE_CLIENT_SECRET=<your-google-client-secret>
GOOGLE_REDIRECT_URI=https://<your-domain>.vercel.app/api/youtube-callback
